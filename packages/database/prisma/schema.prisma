generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonitorMethod {
  GET
  HEAD
}

enum MonitorStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertChannelType {
  DISCORD
  EMAIL
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  displayName    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       Session[]
  monitors       Monitor[]
  alertChannels  AlertChannel[]
  auditEvents    AuditEvent[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Monitor {
  id              String        @id @default(cuid())
  userId          String
  name            String
  url             String
  method          MonitorMethod @default(GET)
  intervalSeconds Int           @default(300)
  timeoutMs       Int           @default(10000)
  status          MonitorStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults    CheckResult[]
  incidents       Incident[]

  @@index([userId, status])
  @@index([status, intervalSeconds])
}

model CheckResult {
  id             String   @id @default(cuid())
  monitorId      String
  checkedAt      DateTime @default(now())
  completedAt    DateTime?
  success        Boolean
  statusCode     Int?
  responseTimeMs Int?
  errorCode      String?
  errorMessage   String?
  monitor        Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@index([checkedAt])
}

model Incident {
  id             String         @id @default(cuid())
  monitorId      String
  status         IncidentStatus @default(OPEN)
  startedAt      DateTime       @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  summary        String
  monitor        Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]

  @@index([monitorId, status])
  @@index([startedAt(sort: Desc)])
}

model AlertChannel {
  id         String           @id @default(cuid())
  userId     String
  type       AlertChannelType
  name       String
  secretRef  String?
  enabled    Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, enabled])
}

model NotificationDelivery {
  id          String       @id @default(cuid())
  incidentId  String
  channelId   String
  attemptedAt DateTime     @default(now())
  deliveredAt DateTime?
  success     Boolean      @default(false)
  errorCode   String?
  incident    Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel     AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([incidentId, attemptedAt])
  @@index([channelId, attemptedAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}

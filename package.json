{
  "name":"api-sentinel",
  "version":"0.1.0",
  "private":true,
  "description":"Open-source API observability and reliability platform",
  "license":"MIT",
  "engines":{"node":">=22.0.0","pnpm":">=10.0.0"},
  "packageManager":"pnpm@10.12.1",
  "scripts":{
    "dev":"turbo run dev --parallel",
    "build":"turbo run build",
    "lint":"turbo run lint",
    "test":"turbo run test",
    "db:generate":"pnpm --filter @sentinel/database db:generate",
    "db:migrate":"pnpm --filter @sentinel/database db:migrate",
    "format:check":"prettier --check .",
    "format":"prettier --write ."
  },
  "devDependencies":{"prettier":"^3.5.3","turbo":"^2.5.4","typescript":"^5.8.3","vitest":"^3.2.4"}
}
